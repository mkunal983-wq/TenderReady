# Copy to .env at the repository root. Never commit credentials.
DATABASE_URL=postgresql+psycopg://tenderready:tenderready@localhost:5432/tenderready
APP_ENV=development
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Select an available NVIDIA Nemotron model with: tenderready models
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_JSON_MODE=false
NEBIUS_TIMEOUT_SECONDS=60
NEBIUS_MAX_OUTPUT_TOKENS=8192
# Optional only for loopback requests in development. APP_ENV=production
# requires an application token of at least 32 characters. This is NOT a Nebius key.
APP_API_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Default private storage: repository data/documents. Set an absolute path to override.
# STORAGE_DIR=/absolute/private/documents
UPLOAD_MAX_BYTES=10485760
PDF_MAX_PAGES=40
PDF_MAX_TEXT_CHARS=160000
PDF_PARSE_TIMEOUT_SECONDS=20
ANALYSIS_TIMEOUT_SECONDS=600
